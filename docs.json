{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Moddy",
  "theme": "almond",
  "colors": {
    "primary": "#0046F8",
    "light": "#BEC2FF",
    "dark": "#0046F8"
  },
  "favicon": {
    "light": "/images/LogoVerif(3).svg",
    "dark": "/favicon.svg"
  },
  "logo": {
    "light": "/images/LogoDocs(1).svg",
    "dark": "/images/LogoDocsDark(1).svg",
    "href": "https://docs.moddy.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://moddy.app/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Add to Discord",
      "href": "https://discord.com/application-directory/1375596170713239622"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://moddy.app/support"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "getting-started/dashboard"
            ]
          },
          {
            "group": "Moderation",
            "pages": [
              "moderation/overview",
              "moderation/cases",
              "moderation/sanctions",
              "moderation/automod"
            ]
          },
          {
            "group": "Modules",
            "pages": [
              "modules/overview",
              "modules/welcome",
              "modules/social-notifications",
              "modules/interserver",
              "modules/altguard"
            ]
          },
          {
            "group": "Utilities",
            "pages": [
              "utilities/overview",
              "utilities/translation",
              "utilities/reminders",
              "utilities/text-tools"
            ]
          },
          {
            "group": "Moddy Max",
            "pages": [
              "premium/overview",
              "premium/features"
            ]
          }
        ]
      },
      {
        "tab": "Commands",
        "groups": [
          {
            "group": "Command Reference",
            "pages": [
              "commands/overview",
              "commands/moderation",
              "commands/utilities",
              "commands/information",
              "commands/configuration"
            ]
          }
        ]
      },
      {
        "tab": "Legal",
        "groups": [
          {
            "group": "Legal",
            "pages": [
              "legal/tos",
              "legal/privacy",
              "legal/license"
            ]
          }
        ]
      }
    ]
  },
  "fonts": {
    "family": "Google Sans"
  },
  "banner": {
    "content": "Moddy is currently under active development and will likely not be ready before **late August 2026**. Stay tuned for updates!",
    "dismissible": true,
    "type": "info"
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "section"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  }
