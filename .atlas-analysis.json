  "keyFeatures": [
    "AI-powered AutoMod with multi-stage detection pipeline (regex, embeddings, nano LLM)",
    "Unified moderation case system with sanctions, timelines, and appeal workflows",
    "Social Notifications for YouTube, Twitch, Bluesky, and RSS feeds",
    "Inter-Server channel bridging across multiple Discord servers",
    "Configurable modules via /config with Discord Components V2 UI",
    "Welcome messages with custom variables and accent colors",
    "Utilities: translation, OCR, dictionary, timestamp generator, dice roller",
    "Personal reminders and saved messages",
    "AltGuard protection against alternate accounts",
    "Moddy Max premium plan with 5 server slots, unlimited AI, VIP support"
  ],
  "publicApiSurface": [
    "/ping — check bot latency",
    "/user — look up a Discord user",
    "/avatar — display a user's avatar",
    "/banner — display a user's banner",
    "/translate — translate text to another language",
    "/reminder — set a personal reminder",
    "/roll — roll dice",
    "/timestamp — generate a Discord timestamp",
    "/config — configure server modules (guild only)",
    "/cases — browse server moderation cases (moderators)",
    "/mycases — view your own moderation cases",
    "/mod case create|view|list|sanction|revoke|edit|note|close",
    "/setup-welcome — configure welcome messages"
  ]
}
